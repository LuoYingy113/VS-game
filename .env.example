# Default password used when creating users without an explicit password
DEFAULT_USER_PASSWORD=

# Frontend (Expo)
# Must include /api suffix because frontend calls like `${API_BASE_URL}/login`
EXPO_PUBLIC_API_BASE_URL=

# Backend app/public URL (used in email verification links)
APP_BASE_URL=

# SMTP email sender settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=
SENDER_NAME=
GMAIL_APP_PASSWORD=

# CORS: comma-separated list, use * for all
CORS_ALLOW_ORIGINS=*
